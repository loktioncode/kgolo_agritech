# MySQL connection string from phpMyAdmin / cPanel
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
DATABASE_URL="mysql://kgolo_user:your_password@localhost:3306/kgolo_sync"

# Secret used to sign JWT tokens — generate with: openssl rand -hex 64
JWT_SECRET="replace_with_a_long_random_secret_minimum_32_chars"

# Token validity (e.g. 30d, 7d, 24h)
JWT_EXPIRES_IN="30d"

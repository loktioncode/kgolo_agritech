# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Check migration state:
#   npm run db:status
#
# DESTRUCTIVE — drops every table in `public` (old project + Prisma history), then applies all migrations:
#   npm run db:fresh
#
# Drop only (no migrate):
#   npm run db:drop-all
#
# Apply pending migrations (normal deploy):
#   npm run db:migrate
#
# Legacy: if an old DB had data but no _prisma_migrations row for init, baseline once then migrate:
#   npm run db:baseline && npm run db:migrate
#
# Format: postgres://USER:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_URL="postgres://postgres:your_password@localhost:5432/postgres"

# Secret used to sign JWT tokens   generate with: openssl rand -hex 64
JWT_SECRET="replace_with_a_long_random_secret_minimum_32_chars"

# Token validity (e.g. 30d, 7d, 24h)
JWT_EXPIRES_IN="3650d"

# Shared secret that mobile clients must send in x-kg-app-secret.
KG_APP_SECRET="replace_with_a_long_random_secret_minimum_32_chars"
# Optional allow-list (comma separated). App ids are auto-derived from the mobile bundle id, e.g. KG_zacokgolofarmerid
KG_ALLOWED_APP_IDS=""

# Optional footer links (Instagram & LinkedIn are coded in the repo)
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=""
NEXT_PUBLIC_SOCIAL_TIKTOK_URL=""

# App downloads (homepage) — used by hero & CTA download buttons
NEXT_PUBLIC_PLAY_STORE_URL=""
# Legacy direct APK fallback (optional; hero uses PLAY_STORE_URL)
NEXT_PUBLIC_APK_URL=""
